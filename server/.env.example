PORT=5454

# รหัสอัปโหลดที่ /admin — ต้องตั้งเมื่อเปิด server สู่ภายนอก (เช่นบน Render)
ADMIN_TOKEN=

# ที่เก็บ farm.db + ไฟล์อัปโหลด (ว่าง = server/data และ server/public/assets/uploads)
FARM_DATA_DIR=

# ที่อยู่ backend เดิมของ yellotalk-bot (bot-server.js) ที่จะเชื่อมแชทเข้าไป
BRIDGE_URL=http://localhost:5353

# botId ของบอทตัวที่ต้องการ mirror แชท (ดูได้จาก GET http://localhost:5353/api/bots)
# ปล่อยว่างได้ตอน dev — จะรันแบบไม่มีสะพานเชื่อมห้องจริง (ใช้ ?dev=1 ฝั่ง client แทน)
BRIDGE_BOT_ID=

# โชว์แชทจากห้อง YelloTalk ในแชทเกมไหม (ค่าเริ่มต้นไม่โชว์ — ต้องตั้ง true ถึงจะโชว์)
# แชทที่พิมพ์ในฟาร์มยังส่งเข้าห้องเหมือนเดิม แท็บคนในห้อง/หลุมยังใช้ได้
BRIDGE_SHOW_ROOM_CHAT=false
